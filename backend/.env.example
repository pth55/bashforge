# ── BashForge Backend .env  ────────────────────────────────────────
# Copy to .env and fill in values

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Session
SESSION_TTL_SECONDS=3600
MAX_CONCURRENT_SESSIONS=20

# Security
SECURE_COOKIES=true

# CORS — your domain(s)
CORS_ORIGINS=["https://yourdomain.com"]

# App
DEBUG=false
MOCK_ECS=false

# AWS — region where ECS cluster lives
AWS_DEFAULT_REGION=ap-south-1

# ECS — fill after running infra/setup-aws.sh
ECS_CLUSTER=bashforge
ECS_TASK_DEFINITION=bashforge-sandbox
ECS_SUBNETS=["subnet-xxx","subnet-yyy"]
ECS_SECURITY_GROUPS=["sg-xxx"]

# Set to true when using default VPC public subnets (no NAT gateway)
ASSIGN_PUBLIC_IP=true
